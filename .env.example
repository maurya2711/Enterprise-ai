# ==============================================================================
# ENTERPRISE AI KNOWLEDGE & SUPPORT COPILOT — ENVIRONMENT TEMPLATE
# ==============================================================================
# DO NOT COMMIT POPULATED .env OR .env.local FILES TO VERSION CONTROL.
# Copy this file to '.env' in your local environment for backend services:
#   PowerShell: Copy-Item .env.example .env
#
# All variables, target services, requirements, and setup steps are documented below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME CONFIGURATION
# Used by: apps/backend (Express Server)
# Required in: Phase 1+
# ------------------------------------------------------------------------------
# Operational environment: 'development' | 'test' | 'production'
NODE_ENV=development

# Port where Express backend listens for HTTP requests
PORT=5000

# Base public URL of the Next.js frontend application (used for CORS origin validation)
FRONTEND_URL=http://localhost:3000

# Base URL prefix for backend REST API endpoints
API_BASE_URL=http://localhost:5000/api/v1


# ------------------------------------------------------------------------------
# 2. PRIMARY DATABASE (MONGODB)
# Used by: apps/backend (Mongoose ODM)
# Required in: Phase 2+
# ------------------------------------------------------------------------------
# Connection URI for the MongoDB primary database (configured as a single-node replica set 'rs0').
# Generated locally via Docker Compose (infrastructure/docker-compose.infra.yml).
MONGODB_URI=mongodb://localhost:27017/enterprise_ai?replicaSet=rs0

# Dedicated connection URI for automated testing (isolated test database)
MONGODB_TEST_URI=mongodb://localhost:27017/enterprise_ai_test?replicaSet=rs0


# ------------------------------------------------------------------------------
# 3. BACKGROUND JOBS & CACHING (REDIS)
# Used by: apps/backend (BullMQ, ioredis, rate-limit-redis)
# Required in: Phase 3+
# ------------------------------------------------------------------------------
# Hostname for Redis instance (use 'localhost' for local development or 'redis' within Docker network)
REDIS_HOST=localhost

# Port for Redis instance
REDIS_PORT=6379

# Password for Redis instance (leave empty if running local unsecured development instance)
REDIS_PASSWORD=


# ------------------------------------------------------------------------------
# 4. VECTOR DATABASE (QDRANT)
# Used by: apps/backend (Vector Indexing, Filtered Similarity Search)
# Required in: Phase 3+
# ------------------------------------------------------------------------------
# HTTP REST endpoint for Qdrant vector database
QDRANT_URL=http://localhost:6333

# API Key for Qdrant Cloud or secured instances (leave empty for local development)
QDRANT_API_KEY=

# Name of the Qdrant vector collection for document knowledge chunks.
# NOTE: Dimension of collection must match the chosen embedding model:
#       - 768 dimensions for Gemini embeddings
#       - 1536 dimensions for OpenAI embeddings
QDRANT_COLLECTION_NAME=enterprise_knowledge_chunks


# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY TOKENS
# Used by: apps/backend (JWT service, Bcrypt, Audit Logger)
# Required in: Phase 2+
# Generated Locally: Generate strong 256-bit cryptographic secrets locally via PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
# ------------------------------------------------------------------------------
# Secret key used to sign and verify short-lived Access Tokens (HS256)
JWT_ACCESS_SECRET=replace_with_strong_256_bit_random_secret_for_access_tokens

# Secret key used to sign and verify persistent Refresh Tokens (HS256)
JWT_REFRESH_SECRET=replace_with_strong_256_bit_random_secret_for_refresh_tokens

# Lifespan of Access Tokens (e.g., '15m', '1h')
JWT_ACCESS_EXPIRATION=15m

# Lifespan of Refresh Tokens (e.g., '7d', '30d')
JWT_REFRESH_EXPIRATION=7d

# Cryptographic secret used for HMAC tamper-evident chaining in AuditLogs
AUDIT_LOG_HMAC_SECRET=replace_with_strong_256_bit_random_secret_for_audit_logs


# ------------------------------------------------------------------------------
# 6. ARTIFICIAL INTELLIGENCE & LLM ORCHESTRATION
# Used by: apps/backend (LangChain.js, LLM Factory, Embeddings Service)
# Required in: Phase 3+ (Ingestion) and Phase 4+ (RAG / Copilot)
# Source: External Provider (Google AI Studio or OpenAI Platform)
# ------------------------------------------------------------------------------
# Active LLM Provider: 'gemini' | 'openai'
LLM_PROVIDER=gemini

# Google Gemini API Key (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (obtain from https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# Model Identifiers (to be validated against active provider capabilities before Phase 4)
GEMINI_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# ------------------------------------------------------------------------------
# 7. DOCUMENT INGESTION & RAG HYPERPARAMETERS
# Used by: apps/backend (Chunker, Vector Search, LLM Context Builder)
# Required in: Phase 3+
# ------------------------------------------------------------------------------
# Target size of text chunks in tokens
CHUNK_SIZE=500

# Overlap size between sequential chunks in tokens
CHUNK_OVERLAP=50

# Maximum number of relevant chunks retrieved for RAG context
RAG_TOP_K=5

# Minimum cosine similarity threshold for retrieved chunks (0.0 to 1.0)
RAG_SIMILARITY_THRESHOLD=0.65

# Maximum allowed document upload file size in bytes (e.g., 52428800 = 50 MB)
MAX_FILE_SIZE_BYTES=52428800


# ------------------------------------------------------------------------------
# 8. RATE LIMITING & SECURITY THRESHOLDS
# Used by: apps/backend (RateLimiter Middleware)
# Required in: Phase 5+
# ------------------------------------------------------------------------------
# Rate limiting time window in milliseconds (900000 ms = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum allowed requests per window for standard endpoints
RATE_LIMIT_MAX_REQUESTS=100
